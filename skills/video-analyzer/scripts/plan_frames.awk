# plan_frames.awk — план таймкодов кадров из карты сцен и интервалов тишины.
#
# Стратегия: КАДР В СЕРЕДИНЕ КАЖДОГО ОТРЕЗКА МЕЖДУ СМЕНАМИ СЦЕНЫ (а не в момент склейки).
# Смены сцены — это ГРАНИЦЫ; полезный контент живёт МЕЖДУ ними. Кадр в момент смены сцены
# садится на середину перехода (whip-pan/растворение) и получается СМАЗАННЫМ; а удержанные
# вставки (экран телефона/скринкаст поверх речи, слайды демо), которые держатся несколько
# секунд между быстрыми склейками, раньше вовсе не сэмплировались (короткие «дыры» не
# добирались) и терялись. Середина отрезка between-cuts = стабильный показанный кадр → чёткий
# и уникальный. Так на демо в план попадает КАЖДЫЙ показанный экран, а не переходы между ними.
#
# Приоритет кадра = ДЛИНА его отрезка: при переполнении бюджета MAXF держим длинные показы
# (реальный контент), режем короткие. Отрезки короче MIN_SEG отбрасываем как переходы/вспышки.
# Длинный отрезок под речь (> MAXGAP) дополнительно добираем раз в ~STEP (закадр над статикой).
# Длинная статичная «говорящая голова» = один отрезок = один кадр (без дублей — прежний плюс).
#
# Вход (через -v и два файла):
#   DUR, MAXF, MAXGAP, STEP, MINF, MINGAP, SPEECH_RATIO, MIN_SEG (мин. длина отрезка, сек)
#   SCENES   — файл "время [сила]" (по строке на смену сцены; сила игнорируется)
#   SILENCE  — файл "начало конец" (по строке на интервал тишины)
# Выход: отсортированные по времени таймкоды (по одному в строке), относительно окна.

function speech_ratio(a, b,   silent, i, lo, hi) {
  # доля [a,b], НЕ покрытая тишиной (1 = сплошная речь, 0 = сплошная тишина)
  if (b <= a) return 1
  silent = 0
  for (i = 0; i < msil; i++) {
    lo = (sil_s[i] > a) ? sil_s[i] : a
    hi = (sil_e[i] < b) ? sil_e[i] : b
    if (hi > lo) silent += hi - lo
  }
  return 1 - silent / (b - a)
}

BEGIN {
  if (MIN_SEG == "") MIN_SEG = 0.7

  # --- читаем времена смен сцены (первое поле; сила не нужна) ---
  ns = 0
  while ((getline line < SCENES) > 0) {
    nf = split(line, a, " ")
    if (nf >= 1 && a[1] != "") { st[ns] = a[1] + 0; ns++ }
  }
  close(SCENES)

  # --- читаем интервалы тишины ---
  msil = 0
  while ((getline line < SILENCE) > 0) {
    nf = split(line, a, " ")
    if (nf >= 2 && a[1] != "") { sil_s[msil] = a[1] + 0; sil_e[msil] = a[2] + 0; msil++ }
  }
  close(SILENCE)

  # --- границы отрезков: 0, отсортированные времена сцен в (0,DUR), DUR ---
  for (i = 0; i < ns; i++) sc[i] = st[i]
  for (i = 0; i < ns; i++) for (j = i + 1; j < ns; j++) if (sc[j] < sc[i]) { tmp = sc[i]; sc[i] = sc[j]; sc[j] = tmp }
  nb = 0; bt[nb++] = 0
  for (i = 0; i < ns; i++) if (sc[i] > 0.001 && sc[i] < DUR - 0.001 && sc[i] != bt[nb - 1]) bt[nb++] = sc[i]
  bt[nb++] = DUR

  # --- кандидаты: середина каждого отрезка (+ добор в длинных под речь) ---
  nc = 0
  for (k = 0; k < nb - 1; k++) {
    ga = bt[k]; gb = bt[k + 1]; L = gb - ga
    if (L < MIN_SEG) continue                       # переход/вспышка — пропускаем
    ct[nc] = (ga + gb) / 2; cp[nc] = L; nc++         # стабильная середина; приоритет = длина
    if (L > MAXGAP && speech_ratio(ga, gb) >= SPEECH_RATIO) {
      kk = int(L / STEP); if (kk < 1) kk = 1
      for (j = 1; j <= kk; j++) { ct[nc] = ga + j * L / (kk + 1); cp[nc] = STEP * 0.4; nc++ }
    }
  }

  # запасной план: сцен нет вовсе → равномерно
  if (nc == 0 && DUR > 0) {
    n = int(DUR / 10); if (n < MINF) n = MINF
    for (i = 0; i < n; i++) { ct[nc] = DUR * (i + 0.5) / n; cp[nc] = 1; nc++ }
  }

  # сортировка кандидатов по времени (с переносом приоритета)
  for (i = 0; i < nc; i++) for (j = i + 1; j < nc; j++) if (ct[j] < ct[i]) {
    tmp = ct[i]; ct[i] = ct[j]; ct[j] = tmp
    tmp = cp[i]; cp[i] = cp[j]; cp[j] = tmp
  }

  # дедуп кадров ближе MINGAP: оставляем с бо́льшим приоритетом (длиннее отрезок)
  m = 0
  for (i = 0; i < nc; i++) {
    if (m > 0 && ct[i] - ot[m - 1] < MINGAP) {
      if (cp[i] > op[m - 1]) { ot[m - 1] = ct[i]; op[m - 1] = cp[i] }
    } else { ot[m] = ct[i]; op[m] = cp[i]; m++ }
  }

  # бюджет: при переполнении РАВНОМЕРНО прореживаем по времени (покрыть всю запись).
  # НЕ по длине отрезка: длинные отрезки — обычно «говорящая голова», а короткие —
  # как раз UI-вставки/экраны; отбор по длине выкинул бы именно полезные экраны.
  if (m > MAXF) {
    m2 = 0
    for (i = 0; i < MAXF; i++) { sel = int(i * m / MAXF); ft[m2++] = ot[sel] }
    for (i = 0; i < m2; i++) ot[i] = ft[i]
    m = m2
  }

  # пол по минимуму: если кадров совсем мало — равномерно покрываем окно
  if (m < MINF && DUR > 0) {
    m = (MINF + 0)
    for (i = 0; i < m; i++) ot[i] = DUR * (i + 0.5) / m
  }

  for (i = 0; i < m; i++) printf "%.3f\n", ot[i]
}
